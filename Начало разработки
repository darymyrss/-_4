use std::env;

// Базовая структура задачи
struct Task {
    id: u32,
    text: String,
}

fn main() {
    // Собираем аргументы командной строки
    let args: Vec<String> = env::args().collect();

    if args.len() > 2 && args[1] == "add" {
        let task_text = &args[2];
        println!("План: Добавить задачу '{}' в список", task_text);
        //  выводим в консоль, без сохранения
    } else {
        println!("Использование: add <текст_задачи>");
    }
}
